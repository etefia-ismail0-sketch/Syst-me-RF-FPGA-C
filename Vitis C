/* 16. BOUCLE PRINCIPALE                                                */

/* ------------------------------------------------------------------- */



int main(void)

{

    uint32_t dernier_heartbeat_ms = 0U;

    uint8_t  led_blink_etat       = 0U;



    if (BSP_InitIOModule() != XST_SUCCESS)

    {

        /* Échec critique d'initialisation matérielle : on reste en

         * boucle sécurisée plutôt que de continuer avec un état

         * indéterminé (fail-safe). */

        while (1)

        {

            /* Blocage volontaire - vérifier le câblage IO Module */

        }

    }



    BSP_InitInterruptions();



    while (1)

    {

        /* --- Traitement de la détection dès qu'un nouvel

         * échantillon filtré est disponible (posé par l'ISR). --- */

        if (g_nouvel_echantillon_pret != 0U)

        {

            g_nouvel_echantillon_pret = 0U;

            FSM_MettreAJour(g_rssi_moyenne_dbm);

        }



        /* --- Trame de statut périodique (heartbeat / supervision) :

         * confirme au VMS/ESP32 que le firmware est actif, même en

         * l'absence d'événement de brouillage. --- */

        if ((g_horloge_systeme_ms - dernier_heartbeat_ms) >= HEARTBEAT_PERIOD_MS)

        {

            char     trame_statut[UART_TX_BUFFER_SIZE];

            uint32_t longueur;



            dernier_heartbeat_ms = g_horloge_systeme_ms;

            led_blink_etat       = (uint8_t)(led_blink_etat ^ 1U);



            longueur = JSON_ConstruireTrameStatut(trame_statut, g_rssi_moyenne_dbm,

                                                   g_etat_courant, g_horloge_systeme_ms,

                                                   g_compteur_alertes);

            UART_EnvoyerTrame(trame_statut, longueur);



            GPIO_MettreAJourLeds(g_etat_courant, led_blink_etat);

        }



        /* Boucle non bloquante : aucune attente active longue, la

         * latence de détection dépend uniquement de la période

         * d'échantillonnage (SAMPLE_PERIOD_MS) et du temps de

         * traitement de la FSM (quelques dizaines de cycles). */

    }



    /* Non atteint. */

    return 0;

} 
