 * Le jour où l'IP FFT/RSSI est intégrée dans le Block Design :

 *   1) repasser SIMULATE_RSSI à 0,

 *   2) remplacer FFT_RSSI_BASEADDR par la vraie macro XPAR_..._BASEADDR

 *      générée pour cette IP (visible dans xparameters.h après export

 *      du hardware et régénération de la plateforme Vitis). */

#define SIMULATE_RSSI               1



#define FFT_RSSI_BASEADDR           0x00000000U /* <-- À REMPLACER par la vraie adresse une fois l'IP FFT/RSSI créée */

#define REG_RSSI_OFFSET             0x00U

#define REG_PEAK_BIN_OFFSET         0x04U

#define REG_STATUS_OFFSET           0x08U

#define REG_CTRL_OFFSET             0x0CU

#define STATUS_DATA_READY_BIT       0x01U



